# Copia a deploy/.env (o exporta). Nada secreto aquí: los secretos son ficheros en deploy/secrets/.
NAVE_PUBLIC_URL=https://nave.example.com
NAVE_PUBLIC_HOST=nave.example.com
NAVE_OIDC_ISSUER=https://idp.example.com/realms/nave
NAVE_OIDC_CLIENT_ID=nave
NAVE_GITHUB_APP_ID=1
NAVE_GITHUB_ALLOWED_ACCOUNTS=mi-organizacion
# Versiones de escáner: deben coincidir con las de las imágenes (ARG SEMGREP_VERSION / TRIVY)
NAVE_SEMGREP_VERSION=1.180.0
NAVE_TRIVY_VERSION=0.75.0
# Socket del motor para el runner. Producción: el de Docker rootless / Podman de un usuario sin
# privilegios. Docker Desktop (Windows): /var/run/docker.sock dentro de la VM
NAVE_ENGINE_SOCKET=/run/user/1000/docker.sock
# Ruta del fragmento HSTS: hsts-prod.conf (producción) o hsts-dev.conf (certificado autofirmado)
NAVE_ENGINE_SOCKET_GID=1000
NAVE_HSTS_FILE=./deploy/nginx/snippets/hsts-prod.conf
