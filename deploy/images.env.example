# Copia a deploy/images.env y sustituye cada valor por una referencia fijada por digest.
# `python deploy/scripts/pin_images.py > deploy/images.lock.env` resuelve los digests de las
# bases (requiere acceso a los registros); ese fichero SÍ se versiona y lo usa CI. Compose se niega a arrancar si falta alguna (`${VAR:?}`) y un test exige
# que cada valor de esta plantilla lleve `@sha256:` (ADR 0022).

# Imágenes base (se usan en `docker compose build` y en servicios de terceros)
NAVE_PYTHON_IMAGE=python:3.12-slim@sha256:REEMPLAZAR
NAVE_PYTHON_ALPINE_IMAGE=python:3.12-alpine@sha256:REEMPLAZAR
NAVE_NODE_IMAGE=node:22-slim@sha256:REEMPLAZAR
NAVE_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable@sha256:REEMPLAZAR
NAVE_POSTGRES_IMAGE=postgres:16@sha256:REEMPLAZAR
NAVE_REDIS_IMAGE=redis:7@sha256:REEMPLAZAR
NAVE_GO_IMAGE=golang:1@sha256:REEMPLAZAR
NAVE_DOCKER_CLI_IMAGE=docker:cli@sha256:REEMPLAZAR
NAVE_TRIVY_BASE_IMAGE=aquasec/trivy:0.75.0@sha256:REEMPLAZAR

# Imágenes propias, publicadas por el workflow `release` (el digest sale del firmado)
NAVE_BACKEND_IMAGE=ghcr.io/PROPIETARIO/nave-backend@sha256:REEMPLAZAR
NAVE_FRONTEND_IMAGE=ghcr.io/PROPIETARIO/nave-frontend@sha256:REEMPLAZAR
NAVE_RUNNER_IMAGE=ghcr.io/PROPIETARIO/nave-runner@sha256:REEMPLAZAR
NAVE_FETCHER_IMAGE=ghcr.io/PROPIETARIO/nave-fetcher@sha256:REEMPLAZAR
NAVE_SEMGREP_IMAGE=ghcr.io/PROPIETARIO/nave-semgrep@sha256:REEMPLAZAR
NAVE_TRIVY_IMAGE=ghcr.io/PROPIETARIO/nave-trivy@sha256:REEMPLAZAR
# Smokescreen no tiene imagen oficial: la construye `release` desde el módulo Go (F7-24).
NAVE_EGRESS_PROXY_IMAGE=ghcr.io/PROPIETARIO/nave-egress-proxy@sha256:REEMPLAZAR

# Solo perfil dev
NAVE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0@sha256:REEMPLAZAR
